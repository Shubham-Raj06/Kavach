# ─── Kavach Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas M30+ recommended for production (replica set required for transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kavach?retryWrites=true&w=majority

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=<strong-random-32-char-secret>
JWT_REFRESH_SECRET=<strong-random-32-char-refresh-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
MODEL_VERSION=v1.0.0

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
# Option A: Paste full service account JSON as string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Set to 'true' to log FCM calls without actually sending (dev/CI)
FIREBASE_MOCK=true

# ── Weather Data ──────────────────────────────────────────────────────────────
# Get free API key from: https://openweathermap.org/api
# Free tier: 60 calls/min. With 272 wards every 3h = ~1.5 calls/min — well within limit.
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Water Quality (DJB) ───────────────────────────────────────────────────────
# Delhi Jal Board API (contact DJB IT dept for credentials)
# Leave empty to use realistic demo data
DJB_API_URL=
DJB_API_KEY=

# ── Hospital API IP Allowlist ─────────────────────────────────────────────────
# Comma-separated IP addresses allowed to POST to /api/ingestion/hospital
# Leave empty in development (all IPs allowed when NODE_ENV != production)
HOSPITAL_API_ALLOWED_IPS=

# ── Email (for OTP / system alerts) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kavach@example.gov.in
SMTP_PASS=<app-password>
FROM_EMAIL="Kavach Alert System <no-reply@kavach.gov.in>"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=https://kavach.gov.in,https://dashboard.kavach.gov.in,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# For ELK: set LOG_FORMAT=json
LOG_FORMAT=json

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
SESSION_SECRET=<strong-session-secret>

# ── Deployment ───────────────────────────────────────────────────────────────
# Used in deployment docs and health check responses
DEPLOYMENT_REGION=ap-south-1
PILOT_DISTRICT=South Delhi
